  "description": "Catálogo online para pequenas lojas de roupas e importados",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx  watch src/server.ts ",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
